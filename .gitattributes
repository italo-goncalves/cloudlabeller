# Normalize text files; store LF in the repo.
* text=auto

# Shell scripts must check out with LF — bash chokes on CRLF.
*.sh text eol=lf

# Binary assets
*.png binary
*.ico binary

# Lock files are byte-compared with uv's (LF) output by
# tools/lock_environment.py --check.
uv.lock text eol=lf
apps/desktop/environment/requirements.lock text eol=lf
