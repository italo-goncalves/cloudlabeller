{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CloudLabeller",
  "version": "../package.json",
  "identifier": "com.rockanalytica.cloudlabeller",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "pnpm --filter @cloudlabeller/web dev",
    "beforeBuildCommand": "pnpm --filter @cloudlabeller/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CloudLabeller",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'",
      "devCsp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/italo-goncalves/cloudlabeller/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../resources/": "./"
    },
    "publisher": "RockAnalytica",
    "copyright": "© 2026 Ítalo Gomes Gonçalves, GPL-3.0-or-later",
    "shortDescription": "CloudLabeller",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
